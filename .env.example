# Required for Bedrock. On AWS leave these unset and use the ECS task role instead.
AWS_ACCESS_KEY=
AWS_ACCESS_SECRETE=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Required for Bedrock. Create them with: uv run python -m ai_maneger.bedrock_guardrail
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1

# Fallback engine, used when Bedrock fails
GROQ_API_KEY=

# Optional
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/agents
# ENV=prod
# ALLOW_SELF_APPROVAL=false   # stop admins deciding on their own requests
# JWT_SECRET=<at least 32 random bytes; required when ENV=prod>
# AUTH_MODE=cognito
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
